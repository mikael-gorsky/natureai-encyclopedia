---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionDoor from '../../components/SectionDoor.astro';
import { locales, sectionOrder, type Locale } from '../../i18n/config';
import { t } from '../../i18n';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const articles = await getCollection('articles', ({ data }) => data.lang === lang && !data.draft);

const plateCounts = sectionOrder.reduce<Record<string, number>>((acc, sec) => {
  acc[sec] = articles.filter((a) => a.data.section === sec).length;
  return acc;
}, {});
---

<BaseLayout title={t(lang, 'site.title')} lang={lang}>
  <section class="landing-hero">
    <div class="landing-hero-inner">
      <span class="landing-eyebrow">{t(lang, 'site.subtitle')}</span>
      <h1 class="landing-title">{t(lang, 'site.title')}</h1>
      <a class="landing-cta" href={`/${lang}/foundations/`}>
        {t(lang, 'cta.enter')} <span aria-hidden>→</span>
      </a>
    </div>
  </section>

  <section class="landing-doors">
    <div class="landing-doors-inner">
      {sectionOrder.map((sec) => (
        <SectionDoor lang={lang} section={sec} plateCount={plateCounts[sec] ?? 0} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .landing-hero {
    min-block-size: 80vh;
    display: grid;
    align-items: center;
    padding: 6rem 2rem 4rem;
    background:
      radial-gradient(circle at 30% 40%, rgb(var(--highlight)) 0%, rgb(var(--bg)) 70%),
      rgb(var(--bg));
  }

  .landing-hero-inner {
    max-inline-size: 90rem;
    margin-inline: auto;
    inline-size: 100%;
    display: grid;
    gap: 2rem;
  }

  .landing-eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--accent));
    font-weight: 500;
  }

  .landing-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 9vw, 9rem);
    line-height: 0.95;
    margin: 0;
    max-inline-size: 22ch;
    color: rgb(var(--ink));
  }

  .landing-cta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: rgb(var(--ink));
    text-decoration: none;
    border-block-end: 1px solid rgb(var(--accent));
    padding-block-end: 0.25rem;
    inline-size: fit-content;
    transition: padding-inline-start 200ms ease;
  }
  .landing-cta:hover {
    padding-inline-start: 0.5rem;
  }

  .landing-doors {
    padding: 4rem 2rem 6rem;
  }

  .landing-doors-inner {
    max-inline-size: 90rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgb(var(--rule));
    border: 1px solid rgb(var(--rule));
  }

  @media (min-width: 768px) {
    .landing-doors-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .landing-doors-inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
