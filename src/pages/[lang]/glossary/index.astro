---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<BaseLayout title={t(lang, 'nav.glossary')} lang={lang}>
  <section class="glossary">
    <header class="glossary-header">
      <span class="glossary-mark">N°</span>
      <h1 class="glossary-title">{t(lang, 'nav.glossary')}</h1>
    </header>
    <p class="glossary-empty"><em>The glossary is being assembled. Plates installed first; their definitions follow.</em></p>
  </section>
</BaseLayout>

<style>
  .glossary {
    max-inline-size: 56rem;
    margin-inline: auto;
    padding: 6rem 2rem 4rem;
  }
  .glossary-header { display: grid; gap: 0.75rem; margin-block-end: 3rem; }
  .glossary-mark {
    font-family: var(--font-display);
    font-style: italic;
    color: rgb(var(--accent));
    font-size: 1.25rem;
  }
  .glossary-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
    font-weight: 400;
    margin: 0;
  }
  .glossary-empty { color: rgb(var(--ink-muted)); font-size: 1rem; }
</style>
