---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localesMeta } from '../i18n/config';
import { t } from '../i18n';
---

<BaseLayout
  title="The Impact of AI on Human Thought"
  description="An encyclopedia in 40 entries — choose a language."
  lang="en"
  noNav
>
  <section class="picker">
    <header class="picker-header">
      <span class="picker-mark">N°</span>
      <h1 class="picker-title">The Impact of AI on Human Thought</h1>
      <p class="picker-sub">An encyclopedia in 40 entries, after Rénald Gesnot, 2025.</p>
    </header>

    <div class="picker-prompt">{t('en', 'languagePicker.choose')}</div>

    <ul class="picker-doors">
      {localesMeta.map((l) => (
        <li>
          <a class="picker-door" href={`/${l.code}/`} lang={l.html} dir={l.dir}>
            <span class="picker-door-label">{l.label}</span>
            <span class="picker-door-arrow" aria-hidden>→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .picker {
    min-block-size: 100vh;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 3rem;
    padding: 4rem 2rem;
    max-inline-size: 56rem;
    margin-inline: auto;
    align-items: start;
  }

  @media (min-width: 768px) {
    .picker {
      padding: 6rem 4rem;
    }
  }

  .picker-header {
    display: grid;
    gap: 0.75rem;
  }

  .picker-mark {
    font-family: var(--font-display);
    font-style: italic;
    color: rgb(var(--accent));
    font-size: 1.25rem;
  }

  .picker-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    font-weight: 400;
    margin: 0;
    max-inline-size: 22ch;
  }

  .picker-sub {
    font-size: 1rem;
    color: rgb(var(--ink-muted));
    max-inline-size: 50ch;
    margin: 0;
  }

  .picker-prompt {
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--ink-muted));
    border-block-end: 1px solid rgb(var(--rule));
    padding-block-end: 0.75rem;
  }

  .picker-doors {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-block-start: 1px solid rgb(var(--rule));
  }

  .picker-door {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.75rem 0.5rem;
    color: rgb(var(--ink));
    text-decoration: none;
    border-block-end: 1px solid rgb(var(--rule));
    transition: padding-inline-start 250ms cubic-bezier(0.22, 0.61, 0.36, 1),
                color 200ms ease;
  }

  .picker-door:hover {
    padding-inline-start: 1.5rem;
    color: rgb(var(--accent));
  }

  .picker-door-label {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
  }

  .picker-door-arrow {
    font-size: 1.5rem;
    color: rgb(var(--ink-muted));
    opacity: 0.5;
    transition: opacity 200ms ease, transform 200ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .picker-door:hover .picker-door-arrow {
    opacity: 1;
    transform: translateX(0.4rem);
  }

  :root[dir="rtl"] .picker-door:hover .picker-door-arrow {
    transform: translateX(-0.4rem);
  }
</style>
